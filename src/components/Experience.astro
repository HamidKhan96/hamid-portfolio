---
import { experience } from "../content/site";
---

<section id="experience" class="section border-t border-white/[0.05]">
  <div class="container-page">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Experience highlights</p>
      <h2 class="mt-4 text-balance text-3xl font-medium leading-tight tracking-tight md:text-4xl">
        Five roles. One throughline: build the system, run the cycle.
      </h2>
    </div>

    <ol class="mt-16 space-y-4">
      {
        experience.map((e, i) => (
          <li class="reveal card">
            <div class="grid gap-6 lg:grid-cols-12">
              <div class="lg:col-span-4">
                <p class="font-mono text-xs text-ink-400">0{i + 1}</p>
                <h3 class="mt-3 text-xl font-medium text-ink-50">{e.company}</h3>
                <p class="mt-1 text-sm text-ink-200">{e.role}</p>
                <p class="mt-1 text-xs text-ink-400">{e.region}</p>
              </div>
              <div class="lg:col-span-8">
                <ul class="space-y-2.5">
                  {e.highlights.map((h) => (
                    <li class="flex gap-3 text-sm text-ink-200">
                      <span class="mt-1.5 inline-block h-1 w-1 shrink-0 rounded-full bg-accent/70" />
                      <span class="leading-relaxed">{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="reveal mt-8 font-mono text-xs text-ink-500">
      Dates available on request. Full timeline in the CV.
    </p>
  </div>
</section>
