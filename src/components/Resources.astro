---
import { resources } from "../content/site";
---

<section id="resources" class="section border-t border-line bg-surface-1/30">
  <div class="container-page">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:gap-12 mb-12 lg:mb-16">
      <div class="lg:col-span-7">
        <p class="section-label">{resources.label}</p>
        <h2 class="heading-serif-mix mt-5 text-balance text-display-lg">
          {resources.heading}
        </h2>
      </div>
      <p class="lg:col-span-5 self-end text-base text-ink-200 max-w-prose">
        {resources.intro}
      </p>
    </div>

    <ul class="grid gap-px overflow-hidden rounded-md border border-line bg-line md:grid-cols-2 lg:grid-cols-3">
      {
        resources.items.map((r, i) => (
          <li
            class="reveal spotlight bg-surface-1 hover:bg-surface-2 transition-colors duration-200 p-6"
            style={`transition-delay: ${i * 40}ms;`}
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="text-base font-medium text-ink-50">{r.title}</h3>
              {!r.available && <span class="tag">Soon</span>}
            </div>
            <p class="mt-3 text-sm text-ink-300 min-h-[42px]">{r.description}</p>
            <a
              href={r.href}
              class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-lime hover:text-lime-dim"
              target={r.href.startsWith("http") ? "_blank" : undefined}
              rel={r.href.startsWith("http") ? "noopener noreferrer" : undefined}
            >
              {r.cta}
              {!r.cta.includes("↗") && (
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M13 5l7 7-7 7" />
                </svg>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
