---
import { resources } from "../content/site";
---

<section id="resources" class="section border-t border-white/[0.05]">
  <div class="container-page">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Resources</p>
      <h2 class="mt-4 text-balance text-3xl font-medium leading-tight tracking-tight md:text-4xl">
        Take what's useful.
      </h2>
    </div>

    <ul class="mt-16 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        resources.map((r) => (
          <li class="reveal card flex flex-col">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-medium text-ink-50">{r.title}</h3>
              {!r.available && <span class="tag">Coming soon</span>}
            </div>
            <p class="mt-3 flex-1 text-sm text-ink-200">{r.description}</p>
            <a
              href={r.href}
              class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-accent hover:text-accent-dim"
              target={r.href.startsWith("http") ? "_blank" : undefined}
              rel={r.href.startsWith("http") ? "noopener noreferrer" : undefined}
            >
              {r.cta}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 5l7 7-7 7"/>
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
