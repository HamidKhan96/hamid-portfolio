---
import { systems } from "../content/site";
---

<section id="systems" class="section">
  <div class="container-page">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:gap-12 mb-14 lg:mb-16">
      <div class="lg:col-span-7">
        <p class="section-label">{systems.label}</p>
        <h2 class="heading-serif-mix mt-5 text-balance text-display-lg">
          {systems.heading}
        </h2>
      </div>
      <p class="lg:col-span-5 self-end text-base text-ink-200 max-w-prose">
        {systems.intro}
      </p>
    </div>

    <ul class="grid gap-px overflow-hidden rounded-md border border-line bg-line">
      {
        systems.items.map((s, i) => (
          <li
            class="reveal bg-surface-1 hover:bg-surface-2 transition-colors duration-200 p-7 md:p-8 grid md:grid-cols-12 gap-4 md:gap-8 items-start"
            style={`transition-delay: ${i * 50}ms;`}
          >
            <div class="md:col-span-1 font-mono text-xs text-ink-400">
              0{s.id}
            </div>
            <div class="md:col-span-4">
              <h3 class="text-lg font-medium text-ink-50 tracking-tight">
                {s.name}
              </h3>
            </div>
            <p class="md:col-span-5 text-sm text-ink-200 leading-relaxed">
              {s.blurb}
            </p>
            <ul class="md:col-span-2 flex flex-wrap gap-1 justify-start md:justify-end">
              {s.tools.slice(0, 3).map((t) => <li class="tag">{t}</li>)}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>
