---
import { profile } from "../content/site";
const year = new Date().getFullYear();
const updated = new Date().toLocaleDateString("en-US", { year: "numeric", month: "short" });
---

<footer class="on-dark">
  <div class="container-page pt-20 pb-10 md:pt-28 md:pb-14">
    <p class="section-label"><span class="font-mono">End of file</span></p>
    <h2 class="heading-serif-mix mt-6 text-balance text-display-lg max-w-4xl">
      Let&rsquo;s build the <em>pipeline</em>.
    </h2>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href={`mailto:${profile.email}`} class="btn btn-primary magnetic">
        Email me
      </a>
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        LinkedIn ↗
      </a>
      <a href={profile.cvPath} class="btn btn-secondary">
        Download CV
      </a>
    </div>
  </div>

  <!-- Big closing serif name signature, full bleed within container -->
  <div class="container-page py-10 border-t border-line">
    <p class="font-serif italic text-[clamp(4rem,15vw,12rem)] text-ink-50 leading-[0.85] tracking-tightest">
      Hamid Khan.
    </p>
  </div>

  <div class="container-page py-6 border-t border-line">
    <div class="flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="font-mono tracking-[0.04em] text-ink-100">hamid.khan</span>
        <span class="text-ink-500">·</span>
        <span class="text-ink-300">GTM Engineer & Account Executive</span>
      </div>

      <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-ink-300">
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-ink-50">LinkedIn</a>
        <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:text-ink-50">GitHub</a>
        <a href={`mailto:${profile.email}`} class="hover:text-ink-50">Email</a>
        <span class="text-ink-600">·</span>
        <span class="text-ink-500 font-mono text-xs">Updated {updated}</span>
        <span class="text-ink-600">·</span>
        <span class="text-ink-500">© {year}</span>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-3 font-mono text-[10px] uppercase tracking-[0.18em] text-ink-500">
      <span>Built in Astro · Deployed on Cloudflare Pages · Coded by Hamid</span>
      <div class="flex flex-wrap items-center gap-3">
        <a
          href="https://github.com/HamidKhan96/hamid-portfolio/commits/main"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-lime transition-colors"
        >
          commit log ↗
        </a>
        <span class="text-ink-600">·</span>
        <a
          href="https://github.com/HamidKhan96/hamid-portfolio"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-lime transition-colors"
        >
          view source ↗
        </a>
      </div>
    </div>
  </div>
</footer>
