---
import { profile } from "../content/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-white/[0.05] py-12">
  <div class="container-page flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
    <div class="flex items-center gap-2">
      <span class="inline-block h-2 w-2 rounded-full bg-accent"></span>
      <span class="text-sm font-medium text-ink-100">{profile.name}</span>
      <span class="text-sm text-ink-400">· GTM Engineer</span>
    </div>

    <div class="flex items-center gap-6 text-sm text-ink-300">
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-ink-50">LinkedIn</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="hover:text-ink-50">GitHub</a>
      <a href={`mailto:${profile.email}`} class="hover:text-ink-50">Email</a>
      <span class="text-ink-500">© {year}</span>
    </div>
  </div>
</footer>
