---
import { pipeline } from "../content/site";
---

<section id="pipeline" class="section border-t border-line bg-surface-1/30">
  <div class="container-page">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:gap-12 mb-14 lg:mb-16">
      <div class="lg:col-span-7">
        <p class="section-label">{pipeline.label}</p>
        <h2 class="heading-serif-mix mt-5 text-balance text-display-lg">
          {pipeline.heading}
        </h2>
      </div>
      <p class="lg:col-span-5 self-end text-base text-ink-200 max-w-prose">
        {pipeline.intro}
      </p>
    </div>

    <!-- Horizontal pipeline stages -->
    <div class="reveal" style="transition-delay: 80ms;">
      <ol class="grid gap-px overflow-hidden rounded-md border border-line bg-line md:grid-cols-3 lg:grid-cols-6">
        {
          pipeline.stages.map((s, i) => (
            <li class="bg-surface-1 p-5 md:p-6 hover:bg-surface-2 transition-colors duration-200">
              <header class="flex items-center justify-between">
                <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-400">
                  Stage {String(i + 1).padStart(2, "0")}
                </span>
                {i < pipeline.stages.length - 1 && (
                  <span class="text-lime/40 text-xs" aria-hidden="true">
                    →
                  </span>
                )}
              </header>
              <h3 class="mt-3 text-base font-medium text-ink-50">
                {s.stage}
              </h3>
              <ul class="mt-4 space-y-1.5">
                {s.items.map((it) => (
                  <li class="text-xs text-ink-200 leading-relaxed">
                    <span class="text-lime/50 mr-1.5">·</span>
                    {it}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
