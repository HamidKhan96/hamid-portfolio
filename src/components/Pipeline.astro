---
import { pipeline } from "../content/site";

const label = pipeline.label.replace(/^\$\s*/, "").replace(/_/g, " ").trim();
const cap = label.charAt(0).toUpperCase() + label.slice(1);
---

<section id="pipeline" class="section">
  <div class="container-page">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:gap-12 mb-14 lg:mb-16">
      <div class="lg:col-span-7">
        <p class="section-label"><span class="font-mono">07 / {cap}</span></p>
        <h2 class="heading-serif-mix mt-6 text-balance text-display-lg">
          {pipeline.heading}
        </h2>
      </div>
      <p class="lg:col-span-5 self-end text-base text-pen-700 max-w-prose">
        {pipeline.intro}
      </p>
    </div>

    <div class="reveal" style="transition-delay: 80ms;">
      <ol class="grid gap-px overflow-hidden rounded-2xl border border-pen-900/10 bg-pen-900/10 md:grid-cols-3 lg:grid-cols-6">
        {
          pipeline.stages.map((s, i) => (
            <li class="spotlight bg-paper p-5 md:p-6 hover:bg-paper-deep transition-colors duration-200">
              <header class="flex items-center justify-between">
                <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-pen-500">
                  Stage {String(i + 1).padStart(2, "0")}
                </span>
                {i < pipeline.stages.length - 1 && (
                  <span class="text-pen-500/60 text-xs" aria-hidden="true">
                    →
                  </span>
                )}
              </header>
              <h3 class="mt-3 text-base font-medium text-pen-900">
                {s.stage}
              </h3>
              <ul class="mt-4 space-y-1.5">
                {s.items.map((it) => (
                  <li class="text-xs text-pen-700 leading-relaxed">
                    <span class="text-lime-deep mr-1.5">·</span>
                    {it}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
