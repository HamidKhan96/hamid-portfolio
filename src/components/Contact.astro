---
import { contact } from "../content/site";
---

<section id="contact" class="section">
  <div class="container-page">
    <div class="reveal grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <p class="section-label">{contact.label}</p>
        <h2 class="heading-serif-mix mt-5 text-balance text-display-lg">
          {contact.heading}
        </h2>
        <p class="mt-6 text-lg text-ink-200 max-w-xl">{contact.subhead}</p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href={`mailto:${contact.email}`} class="btn btn-primary magnetic">
            Email me
          </a>
          <a
            href={contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            LinkedIn ↗
          </a>
        </div>

        <p class="mt-8 font-mono text-[10px] uppercase tracking-[0.18em] text-ink-500">
          // I read every email. Reply window: 24 hours, weekdays.
        </p>
      </div>

      <aside class="lg:col-span-5 reveal" style="transition-delay: 80ms;">
        <div class="card spotlight p-7">
          <div class="flex items-center justify-between mb-5">
            <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-400">
              // contact_card.txt
            </p>
            <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-lime">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-lime animate-[pulseDot_2s_ease-in-out_infinite]"></span>
              online
            </span>
          </div>
          <dl class="space-y-5">
            <div>
              <dt class="meta-key">Email</dt>
              <dd class="mt-1.5">
                <a href={`mailto:${contact.email}`} class="text-ink-100 hover:text-lime">
                  {contact.email}
                </a>
              </dd>
            </div>
            <div>
              <dt class="meta-key">LinkedIn</dt>
              <dd class="mt-1.5">
                <a
                  href={contact.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink-100 hover:text-lime"
                >
                  linkedin.com/in/hamid-m-khan
                </a>
              </dd>
            </div>
            <div>
              <dt class="meta-key">Location</dt>
              <dd class="mt-1.5 text-ink-100">{contact.location}</dd>
            </div>
            <div>
              <dt class="meta-key">Availability</dt>
              <dd class="mt-1.5 text-ink-100">{contact.availability}</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </div>
</section>
