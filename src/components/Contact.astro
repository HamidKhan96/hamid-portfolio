---
import { contact } from "../content/site";
---

<section id="contact" class="section border-t border-white/[0.05]">
  <div class="container-page">
    <div class="reveal grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <p class="eyebrow">Contact</p>
        <h2 class="mt-4 text-balance text-3xl font-medium leading-tight tracking-tight md:text-5xl">
          {contact.heading}
        </h2>
        <p class="mt-6 max-w-2xl text-lg text-ink-200">{contact.subhead}</p>

        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href={`mailto:${contact.email}`} class="btn btn-primary">
            Email me
          </a>
          <a
            href={contact.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-secondary"
          >
            Connect on LinkedIn
          </a>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <dl class="grid gap-4 rounded-2xl border border-white/[0.06] bg-ink-900/40 p-6">
          <div>
            <dt class="eyebrow">Email</dt>
            <dd class="mt-1.5">
              <a href={`mailto:${contact.email}`} class="text-ink-100 hover:text-accent">
                {contact.email}
              </a>
            </dd>
          </div>
          <div>
            <dt class="eyebrow">LinkedIn</dt>
            <dd class="mt-1.5">
              <a
                href={contact.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="text-ink-100 hover:text-accent"
              >
                linkedin.com/in/hamid-m-khan
              </a>
            </dd>
          </div>
          <div>
            <dt class="eyebrow">Location</dt>
            <dd class="mt-1.5 text-ink-100">{contact.location}</dd>
          </div>
          <div>
            <dt class="eyebrow">Availability</dt>
            <dd class="mt-1.5 text-ink-100">{contact.availability}</dd>
          </div>
        </dl>
      </aside>
    </div>
  </div>
</section>
