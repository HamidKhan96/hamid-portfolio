---
import { profile } from "../content/site";

const announcement = {
  label: "Now shipping",
  text: "Outbound system v2 at MUST Company · See how it runs",
  href: "#case-studies",
};

const links = [
  { href: "#principles", label: "Principles" },
  { href: "#case-studies", label: "Case studies" },
  { href: "#live-feed", label: "Live feed" },
  { href: "#systems", label: "Systems" },
  { href: "#pipeline", label: "Skills" },
  { href: "#track-record", label: "Track record" },
];
---

<!-- Thin announcement bar -->
<div class="border-b border-pen-900/10 bg-paper-deep/60 backdrop-blur-md">
  <div class="container-page flex h-9 items-center justify-center text-center">
    <a href={announcement.href} class="group inline-flex items-center gap-3 text-[11px] font-mono uppercase tracking-[0.16em] text-pen-700 hover:text-pen-900 transition-colors">
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 border border-pen-900/30 bg-lime/30 rounded-full">
        <span class="inline-block h-1 w-1 rounded-full bg-lime-deep animate-[pulseDot_2s_ease-in-out_infinite]" aria-hidden="true"></span>
        <span class="text-pen-900">{announcement.label}</span>
      </span>
      <span class="hidden sm:inline">{announcement.text}</span>
      <span class="sm:hidden">Latest work</span>
      <span class="text-pen-500 group-hover:text-pen-900 transition-colors group-hover:translate-x-0.5 inline-block duration-200" aria-hidden="true">→</span>
    </a>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-pen-900/10 bg-paper/85 backdrop-blur-xl">
  <nav
    class="container-page flex h-16 items-center justify-between"
    aria-label="Primary"
  >
    <a href="#top" class="flex items-center gap-2.5 text-sm font-medium text-pen-900">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="font-mono tracking-[0.04em]">hamid.khan</span>
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="text-sm text-pen-700 hover:text-pen-900">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="cmdk-trigger"
        class="hidden md:inline-flex items-center gap-2 border border-pen-900/15 hover:border-pen-900/40 hover:bg-paper-deep rounded-full px-3 py-1.5 text-xs text-pen-700"
        aria-label="Open command palette"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"/>
          <path d="m21 21-4.3-4.3"/>
        </svg>
        <span>Quick nav</span>
        <kbd class="ml-1 font-mono text-[10px] tracking-wider text-pen-500 border-l border-pen-900/15 pl-1.5">⌘K</kbd>
      </button>
      <a href={profile.cvPath} class="btn btn-secondary text-xs hidden sm:inline-flex">
        CV
      </a>
      <a href={`mailto:${profile.email}`} class="btn btn-primary text-xs">
        Get in touch
      </a>

      <button
        id="mobile-menu-toggle"
        class="lg:hidden flex items-center justify-center h-9 w-9 rounded-full border border-pen-900/15 text-pen-700 hover:bg-paper-deep"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 6h18M3 12h18M3 18h18" id="menu-icon" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu drawer -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-pen-900/10 bg-paper/95 backdrop-blur-xl"
  >
    <ul class="container-page py-4 divide-y divide-pen-900/10">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="flex items-center justify-between py-4 text-base text-pen-900 hover:text-pen-700"
              data-mobile-link
            >
              <span>{l.label}</span>
              <span class="text-pen-500" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={profile.cvPath}
          class="flex items-center justify-between py-4 text-base text-pen-900 hover:text-pen-700"
          data-mobile-link
        >
          <span>Download CV</span>
          <span class="text-pen-500" aria-hidden="true">↓</span>
        </a>
      </li>
      <li>
        <button
          type="button"
          id="cmdk-trigger-mobile"
          class="flex w-full items-center justify-between py-4 text-base text-pen-900 hover:text-pen-700"
          data-mobile-link
        >
          <span>Quick nav (⌘K)</span>
          <span class="text-pen-500" aria-hidden="true">⌘</span>
        </button>
      </li>
    </ul>
  </div>
</header>

<script>
  const openPalette = () => {
    const overlay = document.getElementById("cmdk-overlay");
    overlay?.classList.remove("hidden");
    overlay?.classList.add("flex");
    const input = document.getElementById("cmdk-input");
    setTimeout(() => input?.focus(), 30);
  };
  document.getElementById("cmdk-trigger")?.addEventListener("click", openPalette);
  document.getElementById("cmdk-trigger-mobile")?.addEventListener("click", openPalette);

  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
  document.querySelectorAll("[data-mobile-link]").forEach((a) => {
    a.addEventListener("click", () => menu?.classList.add("hidden"));
  });
</script>
