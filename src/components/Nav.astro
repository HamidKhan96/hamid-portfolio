---
import { profile } from "../content/site";

const links = [
  { href: "#principles", label: "Principles" },
  { href: "#case-studies", label: "Case studies" },
  { href: "#live-feed", label: "Live feed" },
  { href: "#systems", label: "Systems" },
  { href: "#pipeline", label: "Skills" },
  { href: "#track-record", label: "Track record" },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-xl">
  <nav
    class="container-page flex h-16 items-center justify-between"
    aria-label="Primary"
  >
    <a href="#top" class="flex items-center gap-2.5 text-sm font-medium text-ink-50">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="font-mono tracking-[0.04em]">hamid.khan</span>
    </a>

    <ul class="hidden items-center gap-7 lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="text-sm text-ink-300 hover:text-ink-50">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a href={profile.cvPath} class="btn btn-secondary text-xs hidden sm:inline-flex">
        CV
      </a>
      <a href={`mailto:${profile.email}`} class="btn btn-primary text-xs">
        Get in touch
      </a>

      <button
        id="mobile-menu-toggle"
        class="lg:hidden flex items-center justify-center h-9 w-9 rounded-md border border-line text-ink-200 hover:bg-surface-2"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M3 6h18M3 12h18M3 18h18" id="menu-icon" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu drawer -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-line bg-bg/95 backdrop-blur-xl"
  >
    <ul class="container-page py-4 divide-y divide-line/60">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="flex items-center justify-between py-4 text-base text-ink-100 hover:text-lime"
              data-mobile-link
            >
              <span>{l.label}</span>
              <span class="text-ink-500" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={profile.cvPath}
          class="flex items-center justify-between py-4 text-base text-ink-100 hover:text-lime"
          data-mobile-link
        >
          <span>Download CV</span>
          <span class="text-ink-500" aria-hidden="true">↓</span>
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById("mobile-menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const isOpen = !menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
  // Close on link click
  document.querySelectorAll("[data-mobile-link]").forEach((a) => {
    a.addEventListener("click", () => menu?.classList.add("hidden"));
  });
</script>
