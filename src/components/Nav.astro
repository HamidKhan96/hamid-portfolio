---
import { profile } from "../content/site";

const links = [
  { href: "#about", label: "About" },
  { href: "#systems", label: "What I build" },
  { href: "#case-studies", label: "Case studies" },
  { href: "#experience", label: "Experience" },
  { href: "#contact", label: "Contact" },
];
---

<header class="sticky top-0 z-40 border-b border-white/[0.05] bg-ink-950/70 backdrop-blur-md">
  <nav class="container-page flex h-16 items-center justify-between" aria-label="Primary">
    <a href="#top" class="flex items-center gap-2 font-medium tracking-tight text-ink-50">
      <span class="inline-block h-2 w-2 rounded-full bg-accent"></span>
      <span>{profile.name}</span>
    </a>

    <ul class="hidden items-center gap-8 md:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} class="text-sm text-ink-300 hover:text-ink-50">
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-3">
      <a href={profile.cvPath} class="btn btn-secondary text-xs hidden sm:inline-flex">
        Download CV
      </a>
      <a href={`mailto:${profile.email}`} class="btn btn-primary text-xs">
        Get in touch
      </a>
    </div>
  </nav>
</header>
