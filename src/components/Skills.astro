---
import { skillsGroups } from "../content/site";
---

<section id="skills" class="section bg-paper-deep">
  <div class="container-page">
    <div class="reveal max-w-3xl">
      <p class="section-label"><span class="font-mono">06 / Skills</span></p>
      <h2 class="heading-serif-mix mt-6 text-balance text-display-md">
        Grouped by what they do, not what they're called.
      </h2>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        skillsGroups.map((g) => (
          <div class="reveal card p-6 md:p-7">
            <h3 class="text-lg font-medium text-pen-900">{g.name}</h3>
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {g.items.map((s) => <li class="tag">{s}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
