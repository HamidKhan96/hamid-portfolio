---
import { skillsGroups } from "../content/site";
---

<section id="skills" class="section border-t border-white/[0.05]">
  <div class="container-page">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Skills</p>
      <h2 class="mt-4 text-balance text-3xl font-medium leading-tight tracking-tight md:text-4xl">
        Grouped by what they do, not what they're called.
      </h2>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-2">
      {
        skillsGroups.map((g) => (
          <div class="reveal card">
            <h3 class="text-lg font-medium text-ink-50">{g.name}</h3>
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {g.items.map((s) => <li class="tag">{s}</li>)}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
