---
import { caseStudies } from "../content/site";
---

<section id="case-studies" class="section border-t border-line bg-surface-1/30">
  <div class="container-page">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:gap-12 mb-14 lg:mb-20">
      <div class="lg:col-span-7">
        <p class="section-label">{caseStudies.label}</p>
        <h2 class="heading-serif-mix mt-5 text-balance text-display-lg">
          {caseStudies.heading}
        </h2>
      </div>
      <p class="lg:col-span-5 self-end text-base text-ink-200 max-w-prose">
        {caseStudies.intro}
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      {
        caseStudies.items.map((c, i) => (
          <article
            class={`reveal ticket scroll-mt-24 ${i === 0 || i === 3 ? "md:col-span-2" : ""}`}
            style={`transition-delay: ${i * 60}ms;`}
            id={c.id}
          >
            <header class="ticket-header">
              <div class="flex items-center gap-3">
                <span class="ticket-id">{c.id}</span>
                <span class="ticket-status">
                  <span class="inline-block h-1.5 w-1.5 rounded-full bg-lime" />
                  {c.status}
                </span>
              </div>
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-400">
                {c.meta.channel} · {c.meta.region}
              </span>
            </header>

            <div class="ticket-body grid gap-8 md:gap-10 md:grid-cols-12">
              <div class="md:col-span-5">
                <h3 class="heading-serif-mix text-balance text-2xl md:text-3xl">
                  {c.title}
                </h3>
                <p class="mt-4 text-base text-ink-200">{c.summary}</p>

                <dl class="mt-6 border-t border-line/70 pt-2">
                  <div class="ticket-field">
                    <dt class="ticket-field-key">Channel</dt>
                    <dd class="ticket-field-val">{c.meta.channel}</dd>
                  </div>
                  <div class="ticket-field">
                    <dt class="ticket-field-key">Region</dt>
                    <dd class="ticket-field-val">{c.meta.region}</dd>
                  </div>
                  <div class="ticket-field">
                    <dt class="ticket-field-key">Duration</dt>
                    <dd class="ticket-field-val">{c.meta.duration}</dd>
                  </div>
                </dl>

                <ul class="mt-5 flex flex-wrap gap-1.5">
                  {c.tools.map((t) => <li class="tag">{t}</li>)}
                </ul>
              </div>

              <div class="md:col-span-7 space-y-6">
                <div>
                  <p class="section-label !text-ink-300">
                    Problem
                  </p>
                  <p class="mt-2.5 text-sm text-ink-200">{c.problem}</p>
                </div>

                <div>
                  <p class="section-label !text-ink-300">
                    System
                  </p>
                  <ol class="mt-3 space-y-2">
                    {c.system.map((step, idx) => (
                      <li class="grid grid-cols-[24px_1fr] gap-2 text-sm text-ink-200">
                        <span class="font-mono text-[10px] text-ink-400 pt-1">0{idx + 1}</span>
                        <span>{step}</span>
                      </li>
                    ))}
                  </ol>
                </div>

                <div class="grid gap-5 sm:grid-cols-2 pt-2 border-t border-line/60">
                  <div>
                    <p class="section-label !text-ink-300">
                      Outcome
                    </p>
                    <p class="mt-2 text-sm text-ink-200">{c.outcome}</p>
                  </div>
                  <div>
                    <p class="section-label !text-ink-300">
                      Proves
                    </p>
                    <p class="mt-2 text-sm text-ink-200">{c.proves}</p>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
