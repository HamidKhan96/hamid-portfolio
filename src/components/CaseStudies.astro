---
import { caseStudies } from "../content/site";
---

<section id="case-studies" class="section border-t border-white/[0.05]">
  <div class="container-page">
    <div class="reveal max-w-3xl">
      <p class="eyebrow">Proof of work</p>
      <h2 class="mt-4 text-balance text-3xl font-medium leading-tight tracking-tight md:text-4xl">
        Four case studies. Anonymized, real systems.
      </h2>
      <p class="mt-6 text-lg text-ink-200">
        Each one shows the problem, the system I built, the outcome, and what it proves about the way I work.
      </p>
    </div>

    <div class="mt-16 grid gap-6">
      {
        caseStudies.map((c) => (
          <article id={c.id} class="reveal card scroll-mt-24">
            <div class="grid gap-10 lg:grid-cols-12">
              <header class="lg:col-span-4">
                <p class="font-mono text-xs uppercase tracking-[0.18em] text-accent">
                  {c.label}
                </p>
                <h3 class="mt-4 text-2xl font-medium leading-tight tracking-tight text-ink-50 md:text-3xl">
                  {c.title}
                </h3>
                <p class="mt-4 text-base text-ink-200">{c.summary}</p>

                <ul class="mt-6 flex flex-wrap gap-1.5">
                  {c.tools.map((t) => <li class="tag">{t}</li>)}
                </ul>
              </header>

              <div class="space-y-8 lg:col-span-8">
                <div>
                  <p class="eyebrow">Problem</p>
                  <p class="mt-3 text-ink-200">{c.problem}</p>
                </div>

                <div>
                  <p class="eyebrow">System</p>
                  <ol class="mt-3 space-y-2.5 text-ink-200">
                    {c.system.map((step, i) => (
                      <li class="flex gap-3">
                        <span class="font-mono text-xs text-ink-400 pt-1">
                          0{i + 1}
                        </span>
                        <span>{step}</span>
                      </li>
                    ))}
                  </ol>
                </div>

                <div class="grid gap-6 sm:grid-cols-2">
                  <div>
                    <p class="eyebrow">Outcome</p>
                    <p class="mt-3 text-ink-200">{c.outcome}</p>
                  </div>
                  <div>
                    <p class="eyebrow">What it proves</p>
                    <p class="mt-3 text-ink-200">{c.proves}</p>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
