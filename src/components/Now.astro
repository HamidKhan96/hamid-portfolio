---
const now = {
  shipping: "MUST Company outbound system (AI personalization, executive proxy, follow-up automation).",
  reading: [
    "Fanatical Prospecting · Jeb Blount",
    "Never Split the Difference · Chris Voss",
    "The New Sales Imperative · Anthony Iannarino",
  ],
  watching: [
    "Josh Braun: lower-the-action breakdowns",
    "Jeremy Miner: NEPQ live calls",
    "Chris Voss: tactical empathy talks",
  ],
  building: [
    "Claude-powered ICP enrichment loop",
    "Apps Script CRM with auto-cadence",
    "Executive LinkedIn voice library v2",
  ],
  asOf: "May 2026",
};
---

<section
  id="now"
  class="section border-t border-line"
>
  <div class="container-page">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:gap-12 mb-12">
      <div class="lg:col-span-7">
        <p class="section-label">$ now</p>
        <h2 class="heading-serif-mix mt-5 text-balance text-display-lg">
          What I'm <em>doing</em> right now.
        </h2>
      </div>
      <p class="lg:col-span-5 self-end text-base text-ink-200 max-w-prose">
        A snapshot of the work, the books, and the people I am studying this quarter. Refreshed when something stops being true.
      </p>
    </div>

    <div class="grid gap-px overflow-hidden rounded-md border border-line bg-line md:grid-cols-2 lg:grid-cols-4">
      <!-- Shipping -->
      <div class="reveal spotlight bg-surface-1 p-6 md:p-8">
        <header class="flex items-center justify-between">
          <span class="meta-key">Shipping</span>
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-lime animate-[pulseDot_2s_ease-in-out_infinite]" />
        </header>
        <p class="mt-4 text-sm text-ink-100 leading-relaxed">
          {now.shipping}
        </p>
      </div>

      <!-- Reading -->
      <div class="reveal spotlight bg-surface-1 p-6 md:p-8" style="transition-delay: 60ms;">
        <span class="meta-key">Reading</span>
        <ul class="mt-4 space-y-2.5">
          {
            now.reading.map((r) => (
              <li class="text-sm text-ink-200 leading-snug flex gap-2">
                <span class="text-lime/60 mt-1" aria-hidden="true">▹</span>
                <span>{r}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Watching -->
      <div class="reveal spotlight bg-surface-1 p-6 md:p-8" style="transition-delay: 120ms;">
        <span class="meta-key">Studying</span>
        <ul class="mt-4 space-y-2.5">
          {
            now.watching.map((w) => (
              <li class="text-sm text-ink-200 leading-snug flex gap-2">
                <span class="text-lime/60 mt-1" aria-hidden="true">▹</span>
                <span>{w}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Building -->
      <div class="reveal spotlight bg-surface-1 p-6 md:p-8" style="transition-delay: 180ms;">
        <span class="meta-key">Building</span>
        <ul class="mt-4 space-y-2.5">
          {
            now.building.map((b) => (
              <li class="text-sm text-ink-200 leading-snug flex gap-2">
                <span class="text-lime/60 mt-1" aria-hidden="true">▹</span>
                <span>{b}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="reveal mt-8 font-mono text-[10px] uppercase tracking-[0.18em] text-ink-500">
      // as of {now.asOf} · refresh window: monthly
    </p>
  </div>
</section>
