---
// A typewriter-style "live activity" feed. Static items, animated reveal,
// then a slow rotation that swaps items in/out.
const events = [
  { t: "08:14", stage: "SOURCING", text: "Trigger detected · Series B funding announcement at target account" },
  { t: "08:42", stage: "ENRICH", text: "ICP run · 142 accounts enriched via Apollo + Sales Navigator" },
  { t: "09:07", stage: "DRAFT", text: "Claude generated voice-matched first touch · cohort CS-002" },
  { t: "09:33", stage: "QA", text: "Manual review pass on 47 drafts · 3 rewritten, 44 approved" },
  { t: "10:05", stage: "SEND", text: "47 emails queued via Gmail API · 90s staggered intervals" },
  { t: "11:48", stage: "REPLY", text: "3 positive replies · 1 meeting booked Tue 2pm · 2 added to nurture" },
  { t: "14:22", stage: "FOLLOWUP", text: "Day-11 follow-up drafted for 12 non-responders · pending review" },
  { t: "16:10", stage: "SYNC", text: "Pipeline written to CRM · next-action dates auto-incremented" },
  { t: "17:35", stage: "REPORT", text: "Daily cohort report exported · pasted into Sheet dashboard" },
];
---

<section
  id="live-feed"
  aria-label="Live activity feed"
  class="section on-dark"
>
  <div class="container-page">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:gap-12 mb-12">
      <div class="lg:col-span-7">
        <p class="section-label"><span class="font-mono">04 / Live feed</span></p>
        <h2 class="heading-serif-mix mt-6 text-balance text-display-lg">
          A day in the <em>pipeline</em>.
        </h2>
      </div>
      <p class="lg:col-span-5 self-end text-base text-ink-200 max-w-prose">
        A rough sketch of what the outbound system produces on a working day. Anonymized signals, real workflow shape.
      </p>
    </div>

    <div class="reveal card spotlight overflow-hidden">
      <header class="flex items-center justify-between border-b border-line bg-surface-2/40 px-5 py-3">
        <div class="flex items-center gap-3">
          <div class="flex gap-1.5">
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-ink-500" />
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-ink-500" />
            <span class="inline-block h-2.5 w-2.5 rounded-full bg-ink-500" />
          </div>
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-ink-400">
            outbound_system.log
          </span>
        </div>
        <div class="flex items-center gap-2">
          <span class="inline-block h-2 w-2 rounded-full bg-lime animate-[pulseDot_2s_ease-in-out_infinite]" />
          <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-lime">LIVE</span>
        </div>
      </header>

      <ol class="divide-y divide-line/60 font-mono text-sm">
        {
          events.map((e, i) => (
            <li
              class="reveal grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 md:grid-cols-[70px_120px_1fr] md:gap-4 items-baseline md:items-center px-4 md:px-5 py-3 md:py-3.5 hover:bg-surface-2/40 transition-colors"
              style={`transition-delay: ${i * 60}ms;`}
            >
              <span class="text-ink-500 tabular-nums text-xs md:text-sm">
                {e.t}
              </span>
              <span class="text-[10px] uppercase tracking-[0.18em] text-lime">
                {e.stage}
              </span>
              <span class="text-ink-200 text-xs md:text-sm col-span-2 md:col-span-1">
                {e.text}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
