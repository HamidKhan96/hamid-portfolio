---
import { principles } from "../content/site";
---

<section id="principles" class="section border-t border-line">
  <div class="container-page">
    <div class="reveal grid gap-6 lg:grid-cols-12 lg:gap-12 mb-14 lg:mb-16">
      <div class="lg:col-span-7">
        <p class="section-label">{principles.label}</p>
        <h2 class="heading-serif-mix mt-5 text-balance text-display-lg">
          {principles.heading}
        </h2>
      </div>
      <p class="lg:col-span-5 self-end text-base text-ink-200 max-w-prose">
        {principles.intro}
      </p>
    </div>

    <ol class="grid gap-px overflow-hidden rounded-md border border-line bg-line md:grid-cols-2 lg:grid-cols-3">
      {
        principles.items.map((p, i) => (
          <li
            class="reveal bg-surface-1 hover:bg-surface-2 transition-colors duration-200 p-7 md:p-8"
            style={`transition-delay: ${i * 50}ms;`}
          >
            <div class="flex items-start gap-4">
              <span class="font-mono text-xs text-lime/80 mt-1">
                {p.n}
              </span>
              <div class="flex-1">
                <h3 class="heading-serif-mix text-xl md:text-2xl text-ink-50 leading-snug">
                  {p.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-200">
                  {p.body}
                </p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <p class="reveal mt-8 font-mono text-[10px] uppercase tracking-[0.18em] text-ink-500">
      // {principles.influences}
    </p>
  </div>
</section>
