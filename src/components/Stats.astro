---
const stats = [
  { value: 3, suffix: "+", label: "Years B2B tech sales" },
  { value: 6, suffix: "", label: "Systems built and shipped" },
  { value: 4, suffix: "", label: "Markets worked (US, LATAM, APAC, EU)" },
  { value: 100, suffix: "%", label: "Full-cycle, SDR through close" },
];

const tools = [
  "Claude", "Apollo", "Sales Navigator", "ZoomInfo", "HubSpot",
  "Salesforce", "n8n", "Sheets", "Apps Script", "Gmail API",
  "Playwright", "Notion", "Calendly",
];
const marquee = [...tools, ...tools, ...tools];
---

<section
  aria-label="Profile statistics"
  class="on-dark"
>
  <div class="container-page py-14 md:py-20">
    <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-md border border-line bg-line md:grid-cols-4">
      {
        stats.map((s, i) => (
          <li class="spotlight bg-surface-1 px-6 py-7 md:px-8 md:py-9 flex flex-col gap-4">
            <div class="flex items-baseline justify-between">
              <p class="font-serif text-5xl md:text-6xl text-ink-50 leading-none">
                <span data-counter={s.value} data-suffix={s.suffix}>0{s.suffix}</span>
              </p>
              <span class="font-mono text-[10px] text-ink-500">0{i + 1}</span>
            </div>
            <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-ink-300">
              {s.label}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Tool marquee, full-width ticker with strong serif treatment -->
  <div class="border-t border-line py-6 md:py-8 overflow-hidden mask-fade-x">
    <ul class="flex w-max animate-ticker gap-12 items-center">
      {
        marquee.map((t, i) => (
          <li class="flex items-center gap-12 whitespace-nowrap">
            <span class="font-serif text-3xl md:text-4xl text-ink-200">
              {t}
            </span>
            <span class={`text-xl ${i % 3 === 0 ? "text-lime/60" : "text-ink-500/60"}`} aria-hidden="true">
              {i % 3 === 0 ? "✦" : "·"}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
