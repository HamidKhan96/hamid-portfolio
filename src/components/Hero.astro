---
import { hero, profile } from "../content/site";
---

<section id="top" class="section pt-24 md:pt-32">
  <div class="container-page">
    <div class="max-w-4xl">
      <p class="eyebrow reveal">{hero.eyebrow}</p>

      <h1
        class="reveal mt-6 text-balance text-4xl font-medium leading-[1.05] tracking-tightest text-ink-50 md:text-6xl lg:text-7xl"
      >
        {hero.headline}
      </h1>

      <p class="reveal mt-8 max-w-2xl text-lg leading-relaxed text-ink-200 md:text-xl">
        {hero.subhead}
      </p>

      <div class="reveal mt-10 flex flex-wrap items-center gap-3">
        <a href={hero.primaryCta.href} class="btn btn-primary">
          {hero.primaryCta.label}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
        <a href={hero.secondaryCta.href} class="btn btn-secondary">
          {hero.secondaryCta.label}
        </a>
        {
          hero.tertiaryLinks.map((l) => (
            <a href={l.href} class="btn btn-ghost text-sm" target={l.href.startsWith("http") ? "_blank" : undefined} rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}>
              {l.label}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M7 17L17 7M7 7h10v10"/>
              </svg>
            </a>
          ))
        }
      </div>

      <p class="reveal mt-12 font-mono text-xs uppercase tracking-[0.18em] text-ink-400">
        {profile.location} · {profile.availability}
      </p>
    </div>
  </div>
</section>
