---
import { hero, profile } from "../content/site";

// Render headline with serif italic word(s) wrapped in { }
function parseHeadline(s: string) {
  const parts: { text: string; italic: boolean }[] = [];
  const re = /\{([^}]+)\}/g;
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(s)) !== null) {
    if (m.index > last) parts.push({ text: s.slice(last, m.index), italic: false });
    parts.push({ text: m[1], italic: true });
    last = m.index + m[0].length;
  }
  if (last < s.length) parts.push({ text: s.slice(last), italic: false });
  return parts;
}
const headlineParts = parseHeadline(hero.headline);

// Top stat trio — fact-based, no fabricated metrics
const stats = [
  { k: "ROLE", v: "AE · GTM Engineer" },
  { k: "MARKETS", v: "US · LATAM · APAC" },
  { k: "STACK", v: "Claude · Apollo · Sheets" },
];
---

<section id="top" class="on-lime relative overflow-hidden">
  <!-- Soft mesh blobs to add depth on the lime block -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div
      class="absolute -top-40 -left-40 h-[640px] w-[640px] rounded-full blur-3xl opacity-60"
      style="background: radial-gradient(circle, rgba(20,18,14,0.07), rgba(20,18,14,0) 65%); animation: heroFloat 18s ease-in-out infinite;"
    />
    <div
      class="absolute bottom-0 -right-32 h-[520px] w-[520px] rounded-full blur-3xl opacity-50"
      style="background: radial-gradient(circle, rgba(255,255,255,0.45), rgba(255,255,255,0) 65%); animation: heroFloat 22s ease-in-out infinite reverse;"
    />
  </div>

  <div class="container-page relative pt-10 pb-16 md:pt-20 md:pb-24 lg:pt-24 lg:pb-28">
    <!-- Top metadata row: status pill + location -->
    <div class="reveal flex flex-wrap items-center justify-between gap-4">
      <div class="status-pill">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="font-mono text-[11px] uppercase tracking-[0.18em] text-pen-900">
          {hero.status.pill}
        </span>
      </div>
      <div class="font-mono text-[11px] uppercase tracking-[0.18em] text-pen-700">
        {profile.location} · {profile.title}
      </div>
    </div>

    <!-- Stat trio (replaces old MetricsStrip — pulled into hero) -->
    <div class="reveal mt-8 grid grid-cols-3 gap-px bg-pen-900/10 border border-pen-900/10 rounded-xl overflow-hidden" style="transition-delay: 60ms;">
      {stats.map((s) => (
        <div class="bg-lime px-4 py-3.5 md:px-5 md:py-4">
          <div class="font-mono text-[10px] uppercase tracking-[0.22em] text-pen-700">{s.k}</div>
          <div class="mt-1 font-mono text-xs md:text-sm text-pen-900 leading-snug">{s.v}</div>
        </div>
      ))}
    </div>

    <!-- Hero grid: massive headline LEFT, portrait card RIGHT -->
    <div class="reveal mt-10 md:mt-14 lg:mt-16 grid gap-10 lg:grid-cols-12 lg:gap-14 items-end" style="transition-delay: 120ms;">
      <div class="lg:col-span-7 xl:col-span-8">
        <h1 class="heading-serif-mix text-balance text-display-lg md:text-display-xl xl:text-display-2xl">
          {
            headlineParts.map((p) =>
              p.italic ? <em>{p.text}</em> : <span>{p.text}</span>
            )
          }
        </h1>

        <p class="mt-7 max-w-xl text-base md:text-lg leading-relaxed text-pen-800">
          {hero.subhead}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={hero.ctas.primary.href} class="btn btn-primary magnetic">
            {hero.ctas.primary.label}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M13 5l7 7-7 7" />
            </svg>
          </a>
          <a href={hero.ctas.secondary.href} class="btn btn-secondary">
            {hero.ctas.secondary.label}
          </a>
          {hero.ctas.tertiary.map((l) => (
            <a
              href={l.href}
              class="ml-2 text-sm text-pen-700 hover:text-pen-900 underline underline-offset-4 decoration-pen-900/30 hover:decoration-pen-900"
              target={l.href.startsWith("http") ? "_blank" : undefined}
              rel={l.href.startsWith("http") ? "noopener noreferrer" : undefined}
            >
              {l.label}
            </a>
          ))}
        </div>

        <p class="mt-6 font-mono text-[12px] uppercase tracking-[0.18em] text-pen-700 flex items-center gap-3">
          <span aria-hidden="true">▸</span>
          <span class="text-pen-500">currently building</span>
          <span id="rotator" class="text-pen-900 min-w-[200px] inline-block">outbound campaigns</span>
          <span class="inline-block w-[2px] h-3 bg-pen-900 animate-[pulseDot_1s_ease-in-out_infinite]" aria-hidden="true"></span>
        </p>
      </div>

      <!-- Portrait slot.
           When Hamid drops a real headshot at /hamid-hero.jpg, swap the
           div block below for: <img src="/hamid-hero.jpg" alt="Hamid Khan" class="..." />
           Until then, this monogram card fills the slot intentionally. -->
      <div class="lg:col-span-5 xl:col-span-4">
        <div class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-pen-900/15 bg-pen-900 shadow-[0_24px_60px_-20px_rgba(20,18,14,0.35)]">
          <!-- Try image first; if absent, the bg art shows through -->
          <img
            src="/hamid-hero.jpg"
            alt="Hamid Khan"
            class="absolute inset-0 h-full w-full object-cover"
            onerror="this.style.display='none'"
            loading="eager"
          />
          <!-- Fallback art (always rendered behind img; visible if img is hidden) -->
          <div class="absolute inset-0 z-0 grid place-items-center">
            <div class="absolute inset-0 opacity-50" style="background:
              radial-gradient(420px circle at 30% 20%, rgba(185,255,102,0.55), transparent 55%),
              radial-gradient(380px circle at 80% 80%, rgba(232,217,184,0.35), transparent 60%);"></div>
            <div class="relative z-10 text-center">
              <div class="font-serif italic text-ink-50 text-[clamp(4rem,12vw,9rem)] leading-none tracking-tight">HK</div>
              <div class="mt-4 font-mono text-[10px] uppercase tracking-[0.28em] text-ink-300">photo placeholder</div>
            </div>
          </div>
          <!-- Bottom caption strip on the card -->
          <div class="absolute left-3 right-3 bottom-3 z-20 flex items-center justify-between gap-3 rounded-lg bg-paper/85 backdrop-blur-sm px-3 py-2 border border-paper">
            <div class="flex items-center gap-2">
              <span class="status-dot" aria-hidden="true"></span>
              <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-pen-900">{profile.name}</span>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-pen-700">2026</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Client strip -->
    <div class="reveal mt-14 md:mt-20 flex flex-wrap items-center gap-3 md:gap-5" style="transition-delay: 240ms;" id="hero-credentials">
      <span class="font-mono text-[10px] uppercase tracking-[0.22em] text-pen-700">
        Shipped at
      </span>
      <span class="tag">MUST Company</span>
      <span class="tag">Bydrec</span>
      <span class="tag">Devsinc</span>
      <span class="tag">Roshan Packages</span>
      <span class="tag">NCRA</span>
    </div>
  </div>
</section>

<script>
  const rotator = document.getElementById("rotator");
  const phrases = [
    "outbound campaigns",
    "executive proxy outreach",
    "AI personalization loops",
    "CRM follow-up systems",
    "ICP research frameworks",
    "pipeline that produces pipeline",
  ];
  let i = 0;
  if (rotator) {
    setInterval(() => {
      i = (i + 1) % phrases.length;
      rotator.style.opacity = "0";
      setTimeout(() => {
        rotator.textContent = phrases[i];
        rotator.style.opacity = "1";
      }, 220);
    }, 2800);
    rotator.style.transition = "opacity 220ms ease";
  }
</script>
