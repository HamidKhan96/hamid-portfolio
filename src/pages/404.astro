---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<Base
  title="404 · Page not found · Hamid Khan"
  description="The URL you followed leads nowhere. Head back to the portfolio."
>
  <Nav />
  <main id="main" class="min-h-[60vh] flex items-center">
    <div class="container-page py-24 md:py-32">
      <div class="max-w-3xl">
        <p class="section-label">$ 404</p>
        <h1 class="heading-serif-mix mt-5 text-balance text-display-xl">
          The URL is <em>dead.</em>
        </h1>
        <p class="mt-8 text-lg text-ink-200 max-w-xl">
          Like a forgotten day-eleven follow-up, the page you wanted is gone. The pipeline keeps moving though.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <a href="/" class="btn btn-primary">
            ← Back to the pipeline
          </a>
          <a href="/#case-studies" class="btn btn-secondary">
            See case studies
          </a>
        </div>

        <pre class="mt-16 font-mono text-[11px] text-ink-500 leading-relaxed">
{`STATUS  → 404
CODE    → URL_NOT_FOUND
ACTION  → Redirecting via the Home button.
NOTE    → If you got here from a real link, ping hamid.m.khann@gmail.com.`}
        </pre>
      </div>
    </div>
  </main>
  <Footer />
</Base>
